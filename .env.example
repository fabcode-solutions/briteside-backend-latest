# Port number
PORT=3000
API_HOST=http://localhost:3000

# Database Credentials
POSTGRESQL_HOST=<db-host>
POSTGRESQL_PORT=<db-port>
POSTGRESQL_DB_NAME=<db_name>
POSTGRESQL_USER=<db_user>
POSTGRESQL_PASSWORD=<db_password>

# JWT
JWT_SECRET=<secret>
JWT_ACCESS_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=30
JWT_RESET_PASSWORD_EXPIRATION_MINUTES=10
JWT_VERIFY_EMAIL_EXPIRATION_MINUTES=10

# Media CDN (CloudFront). When set, public media URLs use this domain instead of raw S3.
# CDN_BASE_URL=https://cdn.example.com

# ACRCloud (copyright-audio scanning for uploaded videos, Identification API).
# Host/Access Key/Access Secret come from the ACRCloud console project.
# Audio Engine is chosen when creating that project in the console — it is
# not a runtime parameter, so there's no corresponding env var here.
ACRCLOUD_HOST=<identify-xx-xxxx-x.acrcloud.com>
ACRCLOUD_ACCESS_KEY=<access_key>
ACRCLOUD_ACCESS_SECRET=<access_secret>