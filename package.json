{
  "name": "BriteSide API",
  "version": "1.0.0",
  "description": "BriteSide Event Management API",
  "main": "src/app.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "prod": "cross-env NODE_ENV=production USE_AWS_SECRETS=true nodemon src/server.js",
    "dev": "nodemon src/server.js",
    "db:generate": "node scripts/with-secrets.js npx drizzle-kit generate",
    "db:migrate": "node scripts/with-secrets.js npx drizzle-kit migrate",
    "db:push": "node scripts/with-secrets.js npx drizzle-kit push",
    "db:studio": "node scripts/with-secrets.js npx drizzle-kit studio",
    "seed": "npm run seed:all && npm run seed:roles && npm run seed:categories && npm run seed:interests && npm run seed:venues && npm run seed:tags && npm run seed:users",
    "seed:roles": "node scripts/seed-roles.js",
    "seed:categories": "node scripts/seed-categories.js",
    "seed:interests": "node scripts/seed-interests.js",
    "seed:admin": "node scripts/seed-admin-user.js",
    "seed:events": "node scripts/seed-events.js",
    "seed:venues": "node scripts/seed-venues.js",
    "seed:tags": "node scripts/seed-tags.js",
    "seed:users": "node scripts/seed-users.js",
    "seed:all": "node scripts/seed-all.js",
    "seed:subscriptions": "node scripts/seed-subscription-plans.js",
    "seed:subscriptions:prod": "cross-env NODE_ENV=production USE_AWS_SECRETS=true node scripts/seed-subscription-plans.js",
    "seed:talent": "node scripts/seed-talent.js",
    "seed:sophia-reviews": "node scripts/seed-sophia-reviews.js",
    "stripe:cutover": "cross-env NODE_ENV=production USE_AWS_SECRETS=true node scripts/stripe-live-cutover.js",
    "stripe:cutover:apply": "cross-env NODE_ENV=production USE_AWS_SECRETS=true node scripts/stripe-live-cutover.js --apply",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:popular-covers": "node scripts/seed-popular-covers.js ./logos ",
    "seed:popular-covers:prod": "cross-env NODE_ENV=production USE_AWS_SECRETS=true node scripts/seed-popular-covers.js ./logos"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "@aws-sdk/client-s3": "^3.908.0",
    "@aws-sdk/client-secrets-manager": "^3.1003.0",
    "@aws-sdk/client-ses": "^3.980.0",
    "@aws-sdk/client-sns": "^3.948.0",
    "@aws-sdk/s3-request-presigner": "^3.1071.0",
    "@stream-io/node-sdk": "^0.7.63",
    "apple-signin-auth": "^2.0.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "body-parser": "^2.2.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csurf": "^1.11.0",
    "dayjs": "^1.11.18",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.5",
    "drizzle-orm": "^0.45.2",
    "drizzle-query-logger": "^1.1.2",
    "drizzle-zod": "^0.8.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "google-auth-library": "^10.5.0",
    "helmet": "^8.1.0",
    "http-status": "^2.1.0",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^3.2.0",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.10",
    "passport": "^0.7.0",
    "passport-apple": "^2.0.2",
    "passport-facebook": "^3.0.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "pg-boss": "^12.19.1",
    "qrcode": "^1.5.4",
    "slugify": "^1.6.6",
    "socket.io": "^4.8.1",
    "stripe": "^19.3.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tldts": "^7.4.13",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "chalk": "^5.6.2",
    "cross-env": "^10.1.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.8.0",
    "vitest": "^3.2.7"
  }
}
